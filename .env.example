# ───── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Viz Studio"

# ───── Better-Auth ──────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-hex-string"

# ───── Database (Neon — free tier) ──────────────────────
# Create a project at https://neon.tech → Connection Details
# Use the "pooled" connection for DATABASE_URL and the
# direct (non-pooled) connection for DIRECT_URL.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ───── OAuth providers (optional but recommended) ───────
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ───── Resend (transactional email — 3000/mo free) ──────
# https://resend.com/api-keys
RESEND_API_KEY=""
# Verify your domain at https://resend.com/domains first.
# Until then, Resend allows test sends from onboarding@resend.dev.
RESEND_FROM="Viz Studio <noreply@vizstudio.io>"

# ───── Stripe ───────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Price IDs — create products in the Stripe dashboard first
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_TEAM_MONTHLY="price_..."
STRIPE_PRICE_TEAM_YEARLY="price_..."
